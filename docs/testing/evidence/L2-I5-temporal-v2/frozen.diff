+                    + ","
+                    + authority
+                    + ",due="
+                    + due
+                    + ",start="
+                    + start
+                    + ",store="
+                    + storeStart
+                    + ".."
+                    + storeEnd
+                    + ",end="
+                    + end
+                    + ","
+                    + outcome
+                    + ",candidates="
+                    + leases
+                    + ",returned="
