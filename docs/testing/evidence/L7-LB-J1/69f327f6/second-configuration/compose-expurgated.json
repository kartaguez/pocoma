{
  "services": {
    "postgres": {
      "image": "postgres@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94",
      "labels": {
        "io.pocoma.local.owner": "73f879b4-ed3e-4c45-b2b2-cd1194d00646"
      },
      "command": [
        "postgres",
        "-c",
        "log_min_error_statement=panic"
      ],
      "environment": {
        "POSTGRES_USER": "pocoma",
        "POSTGRES_DB": "pocoma",
        "POSTGRES_PASSWORD_FILE": "/run/pg-password"
      },
      "volumes": [
        "data:/var/lib/postgresql/data",
        "/private/tmp/pocoma-lb-fresh-8012fb93/.pocoma-local/instances/j1-b-2ad2a840/pg-password:/run/pg-password:ro",
        "/private/tmp/pocoma-lb-fresh-8012fb93/.pocoma-local/instances/j1-b-2ad2a840/pg-init.sql:/docker-entrypoint-initdb.d/01-keycloak.sql:ro"
      ],
      "mem_limit": "1024m",
      "cpus": 1.5,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U pocoma -d pocoma"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 40
      }
    },
    "keycloak": {
      "image": "quay.io/keycloak/keycloak@sha256:0f198be292568439d700cdbfb893e69a6009bb43a94a06a945b1d3d506c76b13",
      "labels": {
        "io.pocoma.local.owner": "73f879b4-ed3e-4c45-b2b2-cd1194d00646"
      },
      "command": [
        "start-dev",
        "--import-realm",
        "--hostname=http://localhost:57563",
        "--health-enabled=true"
      ],
      "environment": {
        "KC_DB": "postgres",
        "KC_DB_URL": "jdbc:postgresql://postgres:5432/pocoma",
        "KC_DB_SCHEMA": "keycloak",
        "KC_DB_USERNAME": "keycloak",
        "KC_DB_PASSWORD": "[REDACTED]",
        "JAVA_OPTS_KC_HEAP": "-Xms128m -Xmx512m"
      },
      "volumes": [
        "/private/tmp/pocoma-lb-fresh-8012fb93/.pocoma-local/instances/j1-b-2ad2a840/realm.json:/opt/keycloak/data/import/pocoma-realm.json:ro"
      ],
      "ports": [
        "127.0.0.1:57563:8080"
      ],
      "mem_limit": "896m",
      "cpus": 1.5
    },
    "http-write": {
