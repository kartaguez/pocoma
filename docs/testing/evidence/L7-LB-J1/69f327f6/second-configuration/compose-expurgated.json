        "--spring.profiles.active=v3-http-admission",
        "--spring.config.additional-location=file:/app/settings.properties"
      ],
      "volumes": [
        "/private/tmp/pocoma-lb-fresh-8012fb93/.pocoma-local/instances/j1-b-2ad2a840/web-write.jar:/app/runtime.jar:ro",
