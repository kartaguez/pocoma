      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Admission HTTP Throughput (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(pocoma_v3_admission_requests_total[1m])) by (endpoint, status) or sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*/commands|/api/.*/registrations|/api/.*/identity/.*\"}[1m])) by (uri, status)",
          "legendFormat": "{{endpoint}}{{uri}} (HTTP {{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": { "h": 7, "w": 8, "x": 12, "y": 0 },
      "id": 2,
      "title": "Admission HTTP Latency p95 (s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(pocoma_v3_admission_http_duration_seconds_bucket[1m])) by (le, endpoint)) or (rate(http_server_requests_seconds_sum{uri=~\"/api/.*/commands|/api/.*/registrations\"}[1m]) / rate(http_server_requests_seconds_count{uri=~\"/api/.*/commands|/api/.*/registrations\"}[1m]))",
          "legendFormat": "p95 {{endpoint}}{{uri}}",
          "refId": "A"
        }
      ]
    },
