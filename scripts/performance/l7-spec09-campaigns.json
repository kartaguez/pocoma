    {"id": "F01-E", "configuration": "A", "rate": 1, "warmupSeconds": 180, "sampleSeconds": 1200, "usableBindingP95Ms": 500, "stimulus": "Registration", "remaining": "provide one authenticated eligible Pot per Registration with projections already available and observe first usable binding"},
