meta {
  name: 01 Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/registrations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("Registration Request accepted", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().requestId).to.match(/^[0-9a-f-]{36}$/i);
  });
}

script:post-response {
  if (res.getStatus() === 202) bru.setVar("registrationRequestId", res.getBody().requestId);
}
