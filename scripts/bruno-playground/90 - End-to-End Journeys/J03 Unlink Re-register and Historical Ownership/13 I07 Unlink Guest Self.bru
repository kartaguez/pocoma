meta {
  name: J03-13-I07 Unlink Guest Self
  type: http
  seq: 13
}

post {
  url: {{writeUrl}}/api/v3/identity/requests
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "operation": "Unlink",
    "bindingToken": "{{bindingActor}}",
    "target": {
      "issuer": "{{issuerUrl}}",
      "subject": "{{actorSubject}}"
    }
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J03-13-I07","role":"guest","saveStaleBinding":true,"requires":["bindingGuest"],"operation":"Unlink","kind":"identityAdmission"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J03-13-I07","role":"guest","saveStaleBinding":true,"requires":["bindingGuest"],"operation":"Unlink","kind":"identityAdmission"};
  const work = require('./lib/workspace.js');
  test('J03-13-I07 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J03-13-I07 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J03 ; etape 13. Source : 01 - Identity and Registration/I07 Unlink Guest Self.bru.
  Desaffiliation de guest lui-meme ; cible derivee de sa session reelle. I05 puis I06 (inactive). Registration permet une nouvelle occurrence, jamais la reutilisation de l ancien binding.
  Identite : guest. Prerequis : bindingGuest.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
