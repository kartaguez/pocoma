meta {
  name: J02-13-B02 My Pots First Page
  type: http
  seq: 13
}

get {
  url: {{readUrl}}/api/v3/me/pots?limit={{pageLimit}}
  body: none
  auth: none
}

headers {
  Connection: close
  X-Pocoma-Binding-Token: {{bindingActor}}
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J02-13-B02","role":"owner","kind":"navigation","binding":true,"wait":true,"status":200};
  bru.setVar('pageLimit', 1);
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J02-13-B02","role":"owner","kind":"navigation","binding":true,"wait":true,"status":200};
  const work = require('./lib/workspace.js');
  test('J02-13-B02 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J02-13-B02 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J02 ; etape 13. Source : 06 - Balances and Navigation/B02 My Pots First Page.bru.
  Navigation propre, limite 1..100 (defaut 20). Capture nextCursor opaque, pas de reconstruction du curseur.
  Identite : actor. Prerequis : URLs de l environnement ; session native si role authentifie.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
