meta {
  name: J01-66-H01 Read Exact Pot History
  type: http
  seq: 66
}

get {
  url: {{readUrl}}/api/v3/pots/{{potId}}/versions/{{historyVersion}}
  body: none
  auth: none
}

headers {
  Connection: close
  X-Pocoma-Binding-Token: {{bindingActor}}
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J01-66-H01","role":"owner","kind":"history","binding":true,"wait":true,"status":200,"requires":["potId","historyVersion"]};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J01-66-H01","role":"owner","kind":"history","binding":true,"wait":true,"status":200,"requires":["potId","historyVersion"]};
  const work = require('./lib/workspace.js');
  test('J01-66-H01 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J01-66-H01 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J01 ; etape 66. Source : 07 - History/H01 Read Exact Pot History.bru.
  Version exacte positive choisie dans historyVersion. Capture expenseReferences opaques et readVersion pour balance/batch au meme instant logique.
  Identite : actor. Prerequis : potId, historyVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
