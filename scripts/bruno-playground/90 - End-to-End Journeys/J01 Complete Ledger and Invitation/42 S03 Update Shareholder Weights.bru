meta {
  name: J01-42-S03 Update Shareholder Weights
  type: http
  seq: 42
}

post {
  url: {{writeUrl}}/api/v3/commands
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "operation": "UpdateShareholderWeights",
    "potId": "{{potId}}",
    "observedVersion": {{potVersion}},
    "bindingToken": "{{bindingActor}}",
    "payload": {
      "targets": [
        {
          "id": "{{shareholderOwnerId}}",
          "weight": {
            "numerator": "2",
            "denominator": "1"
          }
        }
      ]
    }
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J01-42-S03","role":"owner","requires":["potId","potVersion"],"operation":"UpdateShareholderWeights","kind":"commandAdmission"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J01-42-S03","role":"owner","requires":["potId","potVersion"],"operation":"UpdateShareholderWeights","kind":"commandAdmission"};
  const work = require('./lib/workspace.js');
  test('J01-42-S03 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J01-42-S03 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J01 ; etape 42. Source : 03 - Shareholders/S03 Update Shareholder Weights.bru.
  UpdateShareholderWeights : 202 avec requestId seulement. Ouvrir R01 Command Result pour connaitre le resultat metier et actualiser potVersion. Createur ou membre actif ; binding courant, version observee et references valides.
  Identite : actor. Prerequis : potId, potVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
