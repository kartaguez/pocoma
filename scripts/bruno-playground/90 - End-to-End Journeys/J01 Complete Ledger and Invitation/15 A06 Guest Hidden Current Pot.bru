meta {
  name: J01-15-A06 Guest Hidden Current Pot
  type: http
  seq: 15
}

get {
  url: {{readUrl}}/api/v3/pots/{{potId}}
  body: none
  auth: none
}

headers {
  Connection: close
  X-Pocoma-Binding-Token: {{bindingActor}}
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J01-15-A06","role":"guest","kind":"error","binding":true,"wait":true,"status":404,"requires":["potId","bindingGuest"]};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J01-15-A06","role":"guest","kind":"error","binding":true,"wait":true,"status":404,"requires":["potId","bindingGuest"]};
  const work = require('./lib/workspace.js');
  test('J01-15-A06 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J01-15-A06 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J01 ; etape 15. Source : 09 - Access Control and Errors/A06 Guest Hidden Current Pot.bru.
  Guest non attache (avant invitation ou apres depart) : 404 masque, aucune existence divulguee.
  Identite : guest. Prerequis : potId, bindingGuest.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
