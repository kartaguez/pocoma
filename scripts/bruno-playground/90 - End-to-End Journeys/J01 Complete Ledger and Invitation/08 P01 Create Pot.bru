meta {
  name: J01-08-P01 Create Pot
  type: http
  seq: 8
}

post {
  url: {{writeUrl}}/api/v3/commands
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "operation": "CreatePot",
    "potId": "{{potId}}",
    "observedVersion": 0,
    "bindingToken": "{{bindingActor}}",
    "payload": {
      "label": "Voyage Bruno"
    }
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J01-08-P01","role":"owner","newPot":true,"operation":"CreatePot","kind":"commandAdmission"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J01-08-P01","role":"owner","newPot":true,"operation":"CreatePot","kind":"commandAdmission"};
  const work = require('./lib/workspace.js');
  test('J01-08-P01 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J01-08-P01 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J01 ; etape 8. Source : 02 - Pots/P01 Create Pot.bru.
  CreatePot : 202 avec requestId seulement. Ouvrir R01 Command Result pour connaitre le resultat metier et actualiser potVersion. Createur ou membre actif ; binding courant, version observee et references valides.
  Identite : actor. Prerequis : URLs de l environnement ; session native si role authentifie.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
