meta {
  name: J01-27-B01 Exact Balances
  type: http
  seq: 27
}

get {
  url: {{readUrl}}/api/v3/pots/{{potId}}/versions/{{readVersion}}/balance
  body: none
  auth: none
}

headers {
  Connection: close
  X-Pocoma-Binding-Token: {{bindingActor}}
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J01-27-B01","role":"owner","kind":"balance","binding":true,"wait":true,"status":200,"requires":["potId","readVersion"]};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J01-27-B01","role":"owner","kind":"balance","binding":true,"wait":true,"status":200,"requires":["potId","readVersion"]};
  const work = require('./lib/workspace.js');
  test('J01-27-B01 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J01-27-B01 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.exact(bru, expect, res.body.balances, 5, -5, 3);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J01 ; etape 27. Source : 06 - Balances and Navigation/B01 Exact Balances.bru.
  Soldes exacts de readVersion obtenu par P04. Rationnels n/d sous forme de chaines, somme exactement zero ; pas de flottants.
  Identite : actor. Prerequis : potId, readVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
