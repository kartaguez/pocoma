meta {
  name: J01-51-S05 Guest Voluntary Departure DETACH
  type: http
  seq: 51
}

post {
  url: {{writeUrl}}/api/v3/commands
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "operation": "UpdateShareholderDetails",
    "potId": "{{potId}}",
    "observedVersion": {{potVersion}},
    "bindingToken": "{{bindingActor}}",
    "payload": {
      "targets": [
        {
          "id": "{{shareholderGuestId}}",
          "name": "Guest",
          "attachment": "DETACH"
        }
      ]
    }
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"J01-51-S05","role":"guest","requires":["potId","potVersion"],"operation":"UpdateShareholderDetails","kind":"commandAdmission"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"J01-51-S05","role":"guest","requires":["potId","potVersion"],"operation":"UpdateShareholderDetails","kind":"commandAdmission"};
  const work = require('./lib/workspace.js');
  test('J01-51-S05 transport and privacy', () => work.transport(bru, res, expect, options));
  test('J01-51-S05 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Parcours J01 ; etape 51. Source : 03 - Shareholders/S05 Guest Voluntary Departure DETACH.bru.
  UpdateShareholderDetails : 202 avec requestId seulement. Ouvrir R01 Command Result pour connaitre le resultat metier et actualiser potVersion. Createur ou membre actif ; binding courant, version observee et references valides.
  Identite : guest. Prerequis : potId, potVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
