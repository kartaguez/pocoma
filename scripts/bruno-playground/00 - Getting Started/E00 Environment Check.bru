meta {
  name: E00 Environment Check
  type: http
  seq: 1
}

get {
  url: {{issuerUrl}}/.well-known/openid-configuration
  body: none
  auth: none
}

headers {
  Connection: close
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"E00","role":"none","kind":"discovery","status":200};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"E00","role":"none","kind":"discovery","status":200};
  const work = require('./lib/workspace.js');
  test('E00 transport and privacy', () => work.transport(bru, res, expect, options));
  test('E00 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Discovery reelle : issuer exact, Authorization Code et S256. Aucun token requis.
  Identite : none. Prerequis : URLs de l environnement ; session native si role authentifie.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
