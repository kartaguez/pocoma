meta {
  name: P03 Delete Pot
  type: http
  seq: 3
}

post {
  url: {{writeUrl}}/api/v3/commands
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "operation": "DeletePot",
    "potId": "{{potId}}",
    "observedVersion": {{potVersion}},
    "bindingToken": "{{bindingActor}}",
    "payload": {}
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"P03","role":"actor","requires":["potId","potVersion"],"operation":"DeletePot","kind":"commandAdmission"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"P03","role":"actor","requires":["potId","potVersion"],"operation":"DeletePot","kind":"commandAdmission"};
  const work = require('./lib/workspace.js');
  test('P03 transport and privacy', () => work.transport(bru, res, expect, options));
  test('P03 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  DeletePot : 202 avec requestId seulement. Ouvrir R01 Command Result pour connaitre le resultat metier et actualiser potVersion. Createur uniquement ; version courante exacte. Verifier le resultat terminal avant les 404.
  Identite : actor. Prerequis : potId, potVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
