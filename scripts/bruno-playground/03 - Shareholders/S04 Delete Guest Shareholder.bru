meta {
  name: S04 Delete Guest Shareholder
  type: http
  seq: 4
}

post {
  url: {{writeUrl}}/api/v3/commands
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "operation": "DeleteShareholder",
    "potId": "{{potId}}",
    "observedVersion": {{potVersion}},
    "bindingToken": "{{bindingActor}}",
    "payload": {
      "id": "{{shareholderGuestId}}"
    }
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"S04","role":"actor","requires":["potId","potVersion"],"operation":"DeleteShareholder","kind":"commandAdmission"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"S04","role":"actor","requires":["potId","potVersion"],"operation":"DeleteShareholder","kind":"commandAdmission"};
  const work = require('./lib/workspace.js');
  test('S04 transport and privacy', () => work.transport(bru, res, expect, options));
  test('S04 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  DeleteShareholder : 202 avec requestId seulement. Ouvrir R01 Command Result pour connaitre le resultat metier et actualiser potVersion. Createur uniquement ; aucune depense active ne doit referencer la place.
  Identite : actor. Prerequis : potId, potVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
