meta {
  name: A12 Deleted Current Pot
  type: http
  seq: 12
}

get {
  url: {{readUrl}}/api/v3/pots/{{potId}}
  body: none
  auth: none
}

headers {
  Connection: close
  X-Pocoma-Binding-Token: {{bindingActor}}
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"A12","role":"actor","kind":"error","binding":true,"wait":true,"status":404,"requires":["potId","deletedVersion"]};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"A12","role":"actor","kind":"error","binding":true,"wait":true,"status":404,"requires":["potId","deletedVersion"]};
  const work = require('./lib/workspace.js');
  test('A12 transport and privacy', () => work.transport(bru, res, expect, options));
  test('A12 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Apres R01 COMPLETED DeletePot seulement : courant 404. Le parcours verifie aussi la version terminale et l histoire anterieure.
  Identite : actor. Prerequis : potId, deletedVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
