meta {
  name: A13 Deleted Terminal Version
  type: http
  seq: 13
}

get {
  url: {{readUrl}}/api/v3/pots/{{potId}}/versions/{{deletedVersion}}
  body: none
  auth: none
}

headers {
  Connection: close
  X-Pocoma-Binding-Token: {{bindingActor}}
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"A13","role":"actor","kind":"error","binding":true,"wait":true,"status":404,"requires":["potId","deletedVersion"]};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"A13","role":"actor","kind":"error","binding":true,"wait":true,"status":404,"requires":["potId","deletedVersion"]};
  const work = require('./lib/workspace.js');
  test('A13 transport and privacy', () => work.transport(bru, res, expect, options));
  test('A13 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Apres preuve terminale DeletePot : version de suppression 404, histoire precedente conservee.
  Identite : actor. Prerequis : potId, deletedVersion.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
