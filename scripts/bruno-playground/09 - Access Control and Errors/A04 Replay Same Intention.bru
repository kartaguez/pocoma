meta {
  name: A04 Replay Same Intention
  type: http
  seq: 4
}

post {
  url: {{writeUrl}}/api/v3/commands
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
}

body:json {
  {
    "operation": "CreatePot",
    "potId": "{{potId}}",
    "observedVersion": 0,
    "bindingToken": "{{bindingActor}}",
    "payload": {
      "label": "Voyage Bruno"
    }
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"A04","role":"owner","kind":"replay","status":202,"requires":["replayAdmission"],"operation":"CreatePot"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"A04","role":"owner","kind":"replay","status":202,"requires":["replayAdmission"],"operation":"CreatePot"};
  const work = require('./lib/workspace.js');
  test('A04 transport and privacy', () => work.transport(bru, res, expect, options));
  test('A04 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  Reprend exactement le corps et la cle memorises par la derniere admission Command normale ; meme requestId, aucune nouvelle intention. Corps remplace explicitement par la copie en memoire.
  Identite : owner. Prerequis : replayAdmission.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
