meta {
  name: A03 Unknown Identity Field
  type: http
  seq: 3
}

post {
  url: {{writeUrl}}/api/v3/identity/requests
  body: json
  auth: none
}

headers {
  Connection: close
  Content-Type: application/json
}

body:json {
  {
    "operation": "Registration",
    "userId": "forged"
  }
}

settings {
  timeout: 5000
}

script:pre-request {
  const options = {"id":"A03","role":"owner","kind":"error","status":400,"newKey":true,"operation":"Registration"};
  await require('./lib/workspace.js').prepare(bru, req, options);
}

tests {
  const options = {"id":"A03","role":"owner","kind":"error","status":400,"newKey":true,"operation":"Registration"};
  const work = require('./lib/workspace.js');
  test('A03 transport and privacy', () => work.transport(bru, res, expect, options));
  test('A03 contract and variables', () => {
    work.verify(bru, req, res, expect, options);
    work.record(bru, req, res, options);
  });
}

docs {
  400 avant admission ; requester derive du JWT, jamais forge par le JSON.
  Identite : owner. Prerequis : URLs de l environnement ; session native si role authentifie.
  Chaque Send appelle la methode et le corps visibles. Les GET asynchrones attendent
  le meme endpoint au plus 30 s avant l appel affiche ; aucun POST cache.
  Modifier le JSON librement ; une nouvelle intention recoit une nouvelle cle.
}
