meta {
  name: B401 JourneyAndVoluntaryDeparture
  type: http
  seq: 401
}

get {
  url: {{baseUrl}}/api/v3/me/binding
  body: none
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerOwner}}
}

settings {
  timeout: 5000
}

tests {
  expect([200,404]).to.include(res.status);
  expect(res.headers['cache-control']).to.equal('no-store');
  await require(process.env.POCOMA_I4_HELPER || require('path').resolve(process.cwd(),'lib/i4-invitation.js')).run('B401',bru,expect);
  test('B401 JourneyAndVoluntaryDeparture',()=>expect(true).to.equal(true));
}
