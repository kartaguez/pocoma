script:pre-request {
  if (process.env.POCOMA_I4_BASE_URL) {
    bru.setVar('baseUrl',process.env.POCOMA_I4_BASE_URL);
    bru.setVar('bearerOwner',process.env.POCOMA_I4_BEARER_OWNER);
  } else if (process.env.POCOMA_I2_BASE_URL) {
    bru.setVar('baseUrl',process.env.POCOMA_I2_BASE_URL);
    bru.setVar('bearerOwner',process.env.POCOMA_I2_bearerOwner);
  } else {
  for (const name of ['bearerOwner','bearerOther','bearerSameUser','bearerInactive','bearerAbsent','bearerForged','bindingOwner','bindingOther']) {
    const value = process.env['POCOMA_I1_' + name];
    if (!value) throw new Error('Required B1 process secret missing: ' + name);
    bru.setVar(name, value);
  }
  if (process.env.POCOMA_I1_BASE_URL) bru.setVar('baseUrl', process.env.POCOMA_I1_BASE_URL);
  }
}
