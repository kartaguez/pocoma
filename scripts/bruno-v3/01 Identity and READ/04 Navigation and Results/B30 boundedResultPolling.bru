meta {
  name: B30 boundedResultPolling
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/api/v3/commands/00000000-0000-0000-0000-000000000405/result
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{bearerOwner}}
}

tests {
  const base = bru.getVar('baseUrl');
  const id = n => '00000000-0000-0000-0000-' + String(n).padStart(12, '0');
  const pot = id(300), deleted = id(302);
  const header = (who='Owner', token=bru.getVar('bindingOwner')) => ({Authorization:'Bearer '+bru.getVar('bearer'+who), ...(token===null?{}:{'X-Pocoma-Binding-Token':token})});
  let extraCalls = 0;
  const call = async (path, options={}) => { extraCalls++; return await bru.sendRequest({method:'GET',url:base+'/api/v3'+path,headers:header(),timeout:5000,validateStatus:()=>true,...options}); };
  const ref = (n,v=1) => ({id:id(n),headerVersion:v,detailsVersion:v,financialsVersion:v,deleted:false});
  const error = (response,status) => { expect(response.status).to.equal(status); expect(response.headers['cache-control']).to.equal('no-store'); expect(Object.keys(response.data).sort()).to.deep.equal(['code','message','traceId']); expect(JSON.stringify(response.data).length).to.be.below(1025); };
  const main = {status:res.status, data:res.body, headers:res.headers};
  const privateBody = data => { const text=JSON.stringify(data); for(const value of ['userId','authorizedUserIds','attachedActiveUserIds','requesterEui',bru.getVar('bindingOther')]) expect(text.includes(value)).to.equal(false); };
  expect(res.headers['cache-control']).to.equal('no-store');
  test('B30 status, bounded uniform error and no-store', () => error(main,404));
  const fs=require('fs'); const signal=process.env.POCOMA_I1_PUBLISH_SIGNAL; if(!signal) throw new Error('Controlled READ publisher missing'); fs.writeFileSync(signal,'first-404-observed'); const started=performance.now(); const states=[]; for(const route of ['/commands/','/identity/requests/']) { let value={status:404}, attempts=1; for(const delay of [1000,2000,4000]) { if(value.status===200) break; if(performance.now()-started+delay+5000>20000) throw new Error('B30 total deadline'); await bru.sleep(delay); value=await call(route+id(route.includes('identity')?406:405)+'/result'); attempts++; states.push(value.status); if([400,401,413,415].includes(value.status)) throw new Error('B30 deterministic refusal'); expect([200,404,503]).to.include(value.status); } expect(value.status).to.equal(200); expect(value.data.outcome).to.equal('COMPLETED'); expect(attempts).to.be.at.most(4); } expect(performance.now()-started).to.be.below(20000); console.log('B30 bounded fixture polling statuses: '+states.join(','));
  require('fs').appendFileSync(process.env.POCOMA_I1_REQUEST_RECEIPTS, JSON.stringify({scenario:'B30',requests:1+extraCalls,status:main.status})+'\n');
}
