meta {
  name: B21 navigationPages
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/v3/me/pots?limit=100
  body: none
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerOwner}}
  X-Pocoma-Binding-Token: {{bindingOwner}}
}

settings {
  timeout: 5000
}

tests {
  const base = bru.getVar('baseUrl');
  const id = n => '00000000-0000-0000-0000-' + String(n).padStart(12, '0');
  const pot = id(300), deleted = id(302);
  const header = (who='Owner', token=bru.getVar('bindingOwner')) => ({Connection:'close',Authorization:'Bearer '+bru.getVar('bearer'+who), ...(token===null?{}:{'X-Pocoma-Binding-Token':token})});
  let extraCalls = 0;
  const call = async (path, options={}) => { extraCalls++; return await bru.sendRequest({method:'GET',url:base+'/api/v3'+path,headers:header(),timeout:5000,validateStatus:()=>true,...options}); };
  const ref = (n,v=1) => ({id:id(n),headerVersion:v,detailsVersion:v,financialsVersion:v,deleted:false});
  const error = (response,status) => { expect(response.status).to.equal(status); expect(response.headers['cache-control']).to.equal('no-store'); expect(Object.keys(response.data).sort()).to.deep.equal(['code','message','traceId']); expect(JSON.stringify(response.data).length).to.be.below(1025); };
  const main = {status:res.status, data:res.body, headers:res.headers};
  const privateBody = data => { const text=JSON.stringify(data); for(const value of ['userId','authorizedUserIds','attachedActiveUserIds','requesterEui',bru.getVar('bindingOther')]) expect(text.includes(value)).to.equal(false); };
  expect(res.headers['cache-control']).to.equal('no-store');
  test('B21 success and no-store', () => expect(main.status).to.equal(200));
  let page=main, values=[]; for(const size of [100,100,5]) { expect(page.status).to.equal(200); expect(page.data.potIds.length).to.equal(size); values.push(...page.data.potIds); if(size===100) page=await call('/me/pots?limit=100&cursor='+page.data.nextCursor); } expect(new Set(values).size).to.equal(205); expect(values).to.deep.equal(Array.from({length:205},(_,n)=>id(10001+n))); const opened=await call('/pots/'+values[0]); expect(opened.status).to.equal(200); expect(opened.data.id).to.equal(values[0]);
  require('fs').appendFileSync(process.env.POCOMA_I1_REQUEST_RECEIPTS, JSON.stringify({scenario:'B21',requests:1+extraCalls,status:main.status})+'\n');
}
