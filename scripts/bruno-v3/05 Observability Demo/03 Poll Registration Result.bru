meta {
  name: 03 Poll Registration Result
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v3/identity/requests/{{regRequestId}}/result
  body: none
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerToken}}
}

settings {
  timeout: 5000
}

tests {
  expect([200, 404]).to.include(res.status);
  if (res.status === 200) {
    expect(res.body).to.have.property('outcome');
    expect(res.body.outcome).to.equal('CHANGED');
  }
}
