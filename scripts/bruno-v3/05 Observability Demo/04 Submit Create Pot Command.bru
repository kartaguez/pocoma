meta {
  name: 04 Submit Create Pot Command
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v3/commands
  body: json
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerToken}}
  Idempotency-Key: cmd-demo-{{timestamp}}
  Content-Type: application/json
}

body:json {
  {
    "operation": "CreatePot",
    "potId": "{{potId}}",
    "observedVersion": 0,
    "bindingToken": "{{bindingToken}}",
    "payload": {
      "label": "Demo Pot {{timestamp}}"
    }
  }
}

settings {
  timeout: 5000
}

tests {
  expect(res.status).to.equal(202);
  expect(res.body).to.have.property('requestId');
  bru.setVar('cmdRequestId', res.body.requestId);
}
