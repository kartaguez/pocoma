meta {
  name: 08 Prometheus Scrape
  type: http
  seq: 8
}

get {
  url: {{managementUrl}}/actuator/prometheus
  body: none
  auth: none
}

headers {
  Connection: close
}

settings {
  timeout: 5000
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body).to.include('pocoma_v3_admission_capacity_available');
  expect(res.body).to.include('pocoma_v3_attempt_outcomes_total');
}
