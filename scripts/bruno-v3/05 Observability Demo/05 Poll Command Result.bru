meta {
  name: 05 Poll Command Result
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/commands/{{commandId}}/result
  body: none
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerToken}}
}

settings {
  timeout: 5000
}

tests {
  expect([200, 404]).to.include(res.status);
  if (res.status === 200) {
    expect(res.body).to.have.property('status');
  }
}
