meta {
  name: 05 Poll Command Result
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v3/commands/{{cmdRequestId}}/result
  body: none
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerToken}}
}

settings {
  timeout: 5000
}

tests {
  expect([200, 404]).to.include(res.status);
  if (res.status === 200) {
    expect(res.body).to.have.property('outcome');
    expect(res.body.outcome).to.equal('COMPLETED');
    expect(res.body.resultingPotVersion).to.be.at.least(1);
  }
}
