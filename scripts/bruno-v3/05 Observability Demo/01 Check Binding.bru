meta {
  name: 01 Check Binding
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/me/binding
  body: none
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerToken}}
}

settings {
  timeout: 5000
}

tests {
  expect([200, 404]).to.include(res.status);
  if (res.status === 200) {
    expect(res.body).to.have.property('bindingId');
    bru.setVar('bindingId', res.body.bindingId);
  }
}
