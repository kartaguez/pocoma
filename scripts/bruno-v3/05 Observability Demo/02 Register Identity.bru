meta {
  name: 02 Register Identity
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v3/identity/requests
  body: json
  auth: none
}

headers {
  Connection: close
  Authorization: Bearer {{bearerToken}}
  Idempotency-Key: reg-demo-{{timestamp}}
  Content-Type: application/json
}

body:json {
  {
    "operation": "Registration"
  }
}

settings {
  timeout: 5000
}

tests {
  expect(res.status).to.equal(202);
  expect(res.body).to.have.property('requestId');
  bru.setVar('regRequestId', res.body.requestId);
}
