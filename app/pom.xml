<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.kartaguez.pocoma</groupId>
	<artifactId>pocoma</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>pocoma</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
    <module>domain-pot</module>
    <module>domain-identity</module>
    <module>domain-projection</module>
    <module>domain-consumption</module>
    <module>contract-authentication</module>
    <module>contract-write-admission</module>
    <module>contract-read-query</module>
    <module>port-transaction</module>
    <module>port-projection</module>
    <module>engine-admit-command</module>
    <module>engine-admit-identity</module>
    <module>engine-write-pot</module>
    <module>engine-write-identity</module>
    <module>engine-materialize-pot</module>
    <module>engine-materialize-identity</module>
    <module>engine-materialize-results</module>
    <module>engine-read-pot</module>
    <module>engine-read-identity</module>
    <module>engine-read-results</module>
    <module>orchestrator-consumption</module>
    <module>supra-polling-consumption</module>
    <module>supra-web-write</module>
    <module>supra-web-read</module>
    <module>infra-tx-spring</module>
    <module>infra-security-spring</module>
    <module>infra-postgres-write</module>
    <module>infra-postgres-read</module>
    <module>compose-web-write-postgres</module>
    <module>compose-polling-burnable-write-postgres</module>
    <module>compose-polling-nonburnable-materialize-postgres</module>
    <module>compose-web-read-postgres</module>
    <module>runtime-web-write</module>
    <module>runtime-web-read</module>
    <module>runtime-worker-process</module>
    <module>runtime-worker-materialize</module>
    <module>runtime-monolith</module>
    <module>architecture-tests</module>
    <module>contract-consumption</module>
    <module>infra-postgres-core</module>
    <module>infra-postgres-write-source-read</module>
    <module>infra-observability-micrometer</module>
    <module>engine-read-execution</module>
</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Only the verification CLI activates this profile. Compilation outputs stay
	     incremental; the report producers write directly into a new run directory. -->
	<profiles>
		<profile>
			<id>verification-provenance</id>
			<activation>
				<property><name>pocoma.verification.id</name></property>
			</activation>
			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-surefire-plugin</artifactId>
							<configuration>
								<reportsDirectory>${pocoma.verification.reports}/${project.artifactId}/surefire-reports</reportsDirectory>
								<enablePropertiesElement>true</enablePropertiesElement>
								<systemPropertyVariables>
									<pocoma.verification.id>${pocoma.verification.id}</pocoma.verification.id>
									<pocoma.verification.module>${project.artifactId}</pocoma.verification.module>
									<pocoma.verification.producer>surefire</pocoma.verification.producer>
								</systemPropertyVariables>
							</configuration>
						</plugin>
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-failsafe-plugin</artifactId>
							<configuration>
								<reportsDirectory>${pocoma.verification.reports}/${project.artifactId}/failsafe-reports</reportsDirectory>
								<summaryFile>${pocoma.verification.reports}/${project.artifactId}/failsafe-reports/failsafe-summary.xml</summaryFile>
								<enablePropertiesElement>true</enablePropertiesElement>
								<systemPropertyVariables>
									<pocoma.verification.id>${pocoma.verification.id}</pocoma.verification.id>
									<pocoma.verification.module>${project.artifactId}</pocoma.verification.module>
									<pocoma.verification.producer>failsafe</pocoma.verification.producer>
								</systemPropertyVariables>
							</configuration>
						</plugin>
					</plugins>
				</pluginManagement>
			</build>
		</profile>
	</profiles>
</project>
